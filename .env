# Shared secret used to sign/verify JWTs across auth-db and backend.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Postgres (auth-db)
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://authuser:change-me@postgres:5432/authdb

# MQTT / Kafka
MQTT_HOST=mosquitto
MQTT_PORT=1883
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TELEMETRY_TOPIC=telemetry.raw

# Frontend (build-time, consumed by Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_AUTH_URL=http://localhost:8001
