apiVersion: v1
kind: Secret
metadata:
  name: idt-auth
  namespace: idt-demo
type: Opaque
stringData:
  DATABASE_URL: "postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_RDS_ENDPOINT:5432/REPLACE_DATABASE?sslmode=verify-full&sslrootcert=/certs/rds-ca.pem"
  JWT_SECRET: "REPLACE_WITH_A_LONG_RANDOM_SECRET"